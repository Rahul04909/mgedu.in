# ==========================================
# MG Education & Social Development Organization
# Local Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==========================================

# 1. DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mgedu_in
DB_USER=root
DB_PASS=

# 2. RAZORPAY API INTEGRATION
RAZORPAY_KEY_ID=rzp_test_yourKeyId Here
RAZORPAY_KEY_SECRET=yourKeySecretHere

# 3. SMTP EMAIL CONFIGURATION (PHPMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=tls
SMTP_FROM_EMAIL=no-reply@mgedu.in
SMTP_FROM_NAME="MG Education & Social Development"

# 4. GOOGLE PLACES API
GOOGLE_PLACES_API_KEY=AIzaSyYourGooglePlacesKeyHere

# 5. FIREBASE INTEGRATION
FIREBASE_API_KEY=AIzaSyYourFirebaseAPIKeyHere
FIREBASE_AUTH_DOMAIN=mgedu-app.firebaseapp.com
FIREBASE_PROJECT_ID=mgedu-app
FIREBASE_STORAGE_BUCKET=mgedu-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
